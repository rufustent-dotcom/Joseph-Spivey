rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default fallback - deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile rules
    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['uid', 'username', 'avatarUrl']) && 
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username is string &&
        request.resource.data.username.size() >= 3 &&
        request.resource.data.username.size() <= 30;
      allow delete: if false; // Profiles cannot be deleted directly from client
    }

    // Community Feed post rules
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 100;
        
      allow update: if isSignedIn() && (
        // Author can modify details
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == request.auth.uid) ||
        // Other users can like (modify specific fields likes and likesCount)
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'likesCount', 'commentsCount']))
      );
      
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Post comments rules
    match /posts/{postId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 500;
      allow update: if false; // Comments are immutable once posted
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
